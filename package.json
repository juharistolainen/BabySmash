{
  "name": "babysmash",
  "version": "1.0.1",
  "description": "BabySmash — keyboard smash play for babies (Tauri + SvelteKit)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
